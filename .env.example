# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
# O .env.local NÃO deve ser enviado ao GitHub.

# Supabase (PostgreSQL)
# Use o host do pooler (IPv4), com usuário no formato postgres.<ref>,
# para funcionar em ambientes serverless como Vercel.
SUPABASE_DB_HOST=aws-0-us-east-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.SEU_REF_DO_PROJETO
SUPABASE_DB_PASSWORD=SUA_SENHA
SUPABASE_DB_NAME=postgres
SUPABASE_DB_SSL=true

# Senha de acesso ao painel admin (/admin)
ADMIN_PASSWORD=sua-senha-secreta